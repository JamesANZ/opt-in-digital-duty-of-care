# Desktop app (Electron). Copy to apps/desktop/.env. That file is gitignored.
# Overrides a repo-root .env. A variable already exported in the shell wins.
# The key can also be saved in Safety Dashboard > Privacy & JEV.

# TypeSafe API key. Without it, classification stays on-device.
TYPESAFE_API_KEY=

# API root. Defaults to https://api.typesafe.ai when empty.
# Offline mock server: http://127.0.0.1:4778
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Open the bundled demo forum and a local control port. Leave unset for normal browsing.
# DDOC_DEMO=1

# Seed two taught examples on a fresh profile. Also implied by DDOC_DEMO=1.
# DDOC_SEED_DEMO=1
