# Shared by the desktop app and scripts/eval.mjs.
# Copy to .env in this directory. That file is gitignored.
# The desktop app also reads apps/desktop/.env, which overrides this file.
# A variable already exported in the shell wins over both files.
#
# Android and iOS do not read environment variables.
# On those apps, set the key in Safety Dashboard > Privacy & JEV.

# TypeSafe API key. Without it, classification stays on-device.
TYPESAFE_API_KEY=

# API root. Defaults to https://api.typesafe.ai when empty.
# Offline mock server: http://127.0.0.1:4778
# TYPESAFE_BASE_URL=https://api.typesafe.ai
